# TaskFlow Server Environment Configuration

# Application Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/taskflow
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JWT Authentication Secret (Use a long, random string in production)
JWT_SECRET=super_secret_jwt_key_taskflow_change_in_production_32char_minimum

# JWT Expiration (e.g., 7d, 24h, 3600)
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS (Frontend URL)
CLIENT_URL=http://localhost:5173
